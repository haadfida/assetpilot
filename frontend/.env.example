# Production: the Rails API origin the built app calls (leave empty when the API is served from the
# same origin, e.g. behind one reverse proxy). Rails must allow this frontend's origin via CORS_ORIGINS.
VITE_API_URL=
# Development only: where the Vite dev server proxies /api (default http://127.0.0.1:3100).
VITE_PROXY_TARGET=http://127.0.0.1:3100
